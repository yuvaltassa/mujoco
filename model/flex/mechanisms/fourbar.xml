<mujoco model="Elastic four-bar">
  <include file="scene.xml"/>
  <statistic center="0 0 .65" extent="2.1"/>
  <worldbody>
    <camera name="overview" pos="1 -2.45 1.5" xyaxes="0.92584764 0.377897 -0 -0.11556947 0.2831452 0.95208849"/>
    <geom type="box" pos="0 0 .12" size=".8 .22 .12"/>
    <geom type="box" pos="-.55 0 .28" size=".10 .09 .12"/>
    <geom type="box" pos=".55 0 .28" size=".10 .09 .12"/>
    <body name="input" pos="-.55 0 .4">
      <joint name="drive" axis="0 1 0" range="-.65 .65"/>
      <geom type="capsule" fromto="0 0 0 0 0 .6" size=".033" mass=".35"/>
      <geom class="bolt"/>
      <body name="left_fitting" pos="0 0 .6">
        <joint axis="0 1 0"/>
        <geom class="bolt"/>
        <geom type="box" size=".028 .046 .038" mass=".04" material="silver"/>
      </body>
    </body>
    <body name="output" pos=".55 0 .4">
      <joint name="follower" axis="0 1 0" range="-.8 .8"/>
      <geom type="capsule" fromto="0 0 0 0 0 .6" size=".033" mass=".35"/>
      <geom class="bolt"/>
      <body name="right_fitting" pos="0 0 .6">
        <joint axis="0 1 0"/>
        <geom class="bolt"/>
        <geom type="box" size=".028 .046 .038" mass=".04" material="silver"/>
      </body>
    </body>
    <body name="payload" pos="0 0 1">
      <freejoint/>
      <geom type="box" size=".025 .043 .034" mass=".025" material="silver"/>
      <geom type="capsule" fromto="0 0 -.03 0 0 -.12" size=".01" mass=".005"/>
      <geom type="box" pos="0 0 -.16" size=".065 .055 .04" mass=".27" material="load"/>
      <site name="midpoint" size=".004" rgba="1 .8 .3 1"/>
    </body>
    <!-- World-frame flex nodes keep the discrete Newton solve sparse. -->
    <body name="flex_frame" pos="-.55 0 1">
      <flexcomp name="coupler" type="grid" count="25 3 3" spacing="0.0458333333 0.03 0.0225" pos="0.55 0 0" dim="3" dof="trilinear" cellcount="8 1 1" mass="0.18" radius=".001" rgba=".95 .38 .12 1">
        <elasticity young="3000000.0" poisson=".25" damping=".015"/>
        <contact selfcollide="none" internal="false" contype="0" conaffinity="0"/>
      </flexcomp>
    </body>
  </worldbody>
  <equality>
    <connect name="coupler_0_0_0_attach" body1="coupler_0_0_0" body2="left_fitting" anchor="0 0 0"/>
    <connect name="coupler_0_0_1_attach" body1="coupler_0_0_1" body2="left_fitting" anchor="0 0 0"/>
    <connect name="coupler_0_1_0_attach" body1="coupler_0_1_0" body2="left_fitting" anchor="0 0 0"/>
    <connect name="coupler_0_1_1_attach" body1="coupler_0_1_1" body2="left_fitting" anchor="0 0 0"/>
    <connect name="coupler_8_0_0_attach" body1="coupler_8_0_0" body2="right_fitting" anchor="0 0 0"/>
    <connect name="coupler_8_0_1_attach" body1="coupler_8_0_1" body2="right_fitting" anchor="0 0 0"/>
    <connect name="coupler_8_1_0_attach" body1="coupler_8_1_0" body2="right_fitting" anchor="0 0 0"/>
    <connect name="coupler_8_1_1_attach" body1="coupler_8_1_1" body2="right_fitting" anchor="0 0 0"/>
    <connect name="coupler_4_0_0_attach" body1="coupler_4_0_0" body2="payload" anchor="0 0 0"/>
    <connect name="coupler_4_0_1_attach" body1="coupler_4_0_1" body2="payload" anchor="0 0 0"/>
    <connect name="coupler_4_1_0_attach" body1="coupler_4_1_0" body2="payload" anchor="0 0 0"/>
    <connect name="coupler_4_1_1_attach" body1="coupler_4_1_1" body2="payload" anchor="0 0 0"/>
  </equality>
  <actuator>
    <position name="drive" joint="drive" kp="300" dampratio="1" ctrlrange="-.55 .55"/>
  </actuator>
</mujoco>
