<mujoco>
  <!--
  Two free masses hang from the two branches of a tendon of fixed length. The pulley halves the
  force in the second branch, so the masses of 1 and 0.5 are in equilibrium and the attachment
  bodies register 1 and 0.5 at the fixed ends and -1 and -0.5 at the masses.
  -->
  <option gravity="0 0 -1"/>

  <worldbody>
    <body name="fixed">
      <body name="fixedend1">
        <site name="fixedend1"/>
      </body>
      <body name="fixedend2" pos="1 0 0">
        <site name="fixedend2"/>
      </body>
    </body>
    <body name="mass1" pos="0 0 -0.5">
      <freejoint/>
      <geom type="box" size="0.05 0.05 0.05" mass="1"/>
      <body name="massend1">
        <site name="massend1"/>
      </body>
    </body>
    <body name="mass2" pos="1 0 -0.5">
      <freejoint/>
      <geom type="box" size="0.05 0.05 0.05" mass="0.5"/>
      <body name="massend2">
        <site name="massend2"/>
      </body>
    </body>
  </worldbody>

  <tendon>
    <spatial name="rope">
      <site site="massend1"/>
      <site site="fixedend1"/>
      <pulley divisor="2"/>
      <site site="fixedend2"/>
      <site site="massend2"/>
    </spatial>
  </tendon>

  <equality>
    <tendon tendon1="rope"/>
  </equality>

  <sensor>
    <force site="fixedend1" user="0 0 1"/>
    <force site="fixedend2" user="0 0 0.5"/>
    <force site="massend1" user="0 0 -1"/>
    <force site="massend2" user="0 0 -0.5"/>
  </sensor>
</mujoco>
